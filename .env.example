# Copy to .env and fill in. Never commit .env.
# Prices, model names and voice IDs: check the providers' current pages and
# record what you chose (and the date) in docs/DECISIONS.md.

# --- App ---
APP_ENV=development
FRONTEND_URL=http://localhost:5173
# Your Vercel preview URLs only (edit "language-learner" to your Vercel project name)
VERCEL_PREVIEW_REGEX=^https://language-learner(-[a-z0-9-]+)?\.vercel\.app$

# --- Database ---
# Local (docker compose): postgresql+asyncpg://app:app@localhost:5432/app
# Supabase: use the connection string from Project Settings -> Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# --- Gemini (paid tier) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_UTILITY_MODEL=
GEMINI_STT_MODEL=

# --- TTS: active provider ---
# google | elevenlabs | cartesia  (choose with backend/scripts/tts_bench.py)
TTS_PROVIDER=google
# Characters/month included in the active provider's free tier or plan.
# At 95% the app switches to the free fallback (edge-tts) to avoid overage.
TTS_MONTHLY_CHARS=1000000

# Voice lists below: comma-separated id:label pairs, e.g. abc123:Zofia,def456:Marek
# Only the providers you have credentials for are used (app and benchmark).

# --- Google Cloud Text-to-Speech (Chirp 3 HD) ---
# Path to the service-account JSON key (never commit it).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICES_PL=
GOOGLE_TTS_VOICES_PT=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICES_PL=
ELEVENLABS_VOICES_PT=

# --- Cartesia ---
CARTESIA_API_KEY=
CARTESIA_MODEL=
CARTESIA_VOICES_PL=
CARTESIA_VOICES_PT=

# --- edge-tts fallback voices ---
EDGE_VOICES_PL=pl-PL-ZofiaNeural,pl-PL-MarekNeural
EDGE_VOICES_PT=pt-BR-FranciscaNeural,pt-BR-AntonioNeural

# --- Budget & caps ---
MONTHLY_BUDGET_USD=15
# USD per 1M tokens (Gemini) and per 1K characters beyond the TTS allowance
# (0 while you stay inside a free tier)
PRICE_CHAT_INPUT_PER_M=0
PRICE_CHAT_OUTPUT_PER_M=0
PRICE_UTILITY_INPUT_PER_M=0
PRICE_UTILITY_OUTPUT_PER_M=0
PRICE_STT_AUDIO_INPUT_PER_M=0
PRICE_TTS_PER_1K_CHARS=0
DAILY_LLM_CALLS_PER_USER=400
DAILY_STT_SECONDS_PER_USER=3600
DAILY_TTS_CHARS_PER_USER=8000
TTS_CACHE_MAX_MB=200

# --- Conversation memory ---
WINDOW_TURNS=3
SUMMARY_BATCH_TURNS=3
