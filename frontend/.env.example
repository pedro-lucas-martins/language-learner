# Local development defaults to http://localhost:8000 when unset.
# On Vercel set VITE_API_URL to the Render backend (https://<service>.onrender.com).
# VITE_WS_URL is derived from it (https -> wss); set it only if the WebSocket lives elsewhere.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
